{
  "name": "depop",
  "version": "0.0.1.1",
  "description": "Hide stars, followers, and watchers on GitHub",
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "build": "node scripts/build.ts",
    "diff:browsers": "git diff --no-index dist/chrome dist/firefox || true",
    "clean": "rm -rf ./dist",
    "check": "dprint check && typos . .github && biome check && tsc --noEmit && pnpm run check:manifest && ghadiag",
    "check:manifest": "node scripts/manifestValidator.ts",
    "check:firefox": "node scripts/lintFirefox.ts",
    "sign:firefox": "node scripts/signFirefox.ts",
    "start:firefox": "web-ext run -c web-ext-config.mts",
    "resize": "mogrify -resize 128x128! assets/icons/**/*128x128*.png",
    "remove-exif": "exiftool -all= ./assets/**/*.png ./assets/**/*.jpg",
    "bump:biome_config": "biome migrate --write && dprint fmt",
    "all": "pnpm run setup && pnpm run check && pnpm run build && pnpm run check:firefox && pnpm run resize"
  },
  "dependencies": {
    "vanjs-core": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "8.20.0",
    "chrome-types": "0.1.459",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "ghadiag": "github:kachick/ghadiag",
    "pretty-bytes": "7.2.0"
  }
}
